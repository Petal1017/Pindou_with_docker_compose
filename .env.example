# Docker runtime configuration. These values are injected when the container
# starts, so the same GHCR image can be reused in every environment.
SUPABASE_URL=http://localhost:55321
SUPABASE_ANON_KEY=replace-with-the-anon-key-from-supabase-status
TURNSTILE_SITE_KEY=

# Optional container settings.
PINDOU_PORT=5280
PINDOU_IMAGE=ghcr.io/your-account/pindou-studio:latest
