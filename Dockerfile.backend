FROM docker:27-dind

ARG TARGETARCH
ARG SUPABASE_CLI_VERSION=2.116.0

RUN apk add --no-cache curl ca-certificates \
    && asset="supabase_${SUPABASE_CLI_VERSION}_linux_${TARGETARCH}.apk" \
    && base_url="https://github.com/supabase/cli/releases/download/v${SUPABASE_CLI_VERSION}" \
    && case "$TARGETARCH" in \
         amd64) checksum="4cdea6f7df3c6d463b80c017f48343811624bb3f1503751d8f6554d8d1f78d66" ;; \
         arm64) checksum="adfa621face129dfbf20cc7c2ad83ecdc8534cda78f760f4daddb13e95612421" ;; \
         *) echo "Unsupported architecture: $TARGETARCH" >&2; exit 1 ;; \
       esac \
    && curl -fL --retry 8 --retry-all-errors --retry-delay 2 \
       --continue-at - --output "/tmp/${asset}" "${base_url}/${asset}" \
    && echo "${checksum}  /tmp/${asset}" | sha256sum -c - \
    && apk add --no-cache --allow-untrusted "/tmp/${asset}" \
    && rm -f "/tmp/${asset}" \
    && supabase --version

ENV DOCKER_TLS_CERTDIR=""
ENV TINI_SUBREAPER=1
WORKDIR /workspace

COPY supabase ./supabase
COPY docker/backend-entrypoint.sh /usr/local/bin/pindou-backend-entrypoint

RUN chmod +x /usr/local/bin/pindou-backend-entrypoint

EXPOSE 55321 54322 54323 54324

HEALTHCHECK --interval=10s --timeout=5s --start-period=180s --retries=30 \
  CMD curl -fsS http://127.0.0.1:55321/auth/v1/health >/dev/null || exit 1

ENTRYPOINT ["/usr/local/bin/pindou-backend-entrypoint"]
